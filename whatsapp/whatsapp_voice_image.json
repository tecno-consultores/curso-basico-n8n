              "description": "un campo de un identificador numerico, por ejemplo: 000023467467",
              "required": true
            },
            {
              "name": "Identificación:",
              "description": "un campo numerico de 8 digitos, por ejemplo: 12345678",
              "required": true
            },
            {
              "name": "Origen:",
              "description": "esta es un campo mixto solo debes traer los primeros 4 caracteres de la cadena, por ejemplo: 0102****2488, debes traer 0102",
              "required": true
            },
            {
              "name": "Monto:",
              "description": "este es un campo de formato de moneda que puede empezar o terminar con la cadena de texto: Bs, debes traer el monto asociado",
              "required": true
            },
            {
              "name": "Destino:",
              "description": "este es un campo numerico que corresponde a un nuemro de telefono de 11 digitos, por ejemplo: 04123557345",
              "required": true
            },
            {
              "name": "Banco:",
